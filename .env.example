# Cadena de conexión a PostgreSQL (Render).
# - External URL: para trabajar desde tu PC (migraciones, seed). Requiere DATABASE_SSL="true".
# - Internal URL: para el servicio desplegado dentro de Render. No requiere SSL.
DATABASE_URL=

# "true" para conectar con SSL (External URL de Render).
# Ausente o "false" para conectar sin SSL (Internal URL).
DATABASE_SSL=

# Opcional: email del usuario ADMIN que crea el seed.
# Si no se define, usa araoz.leticia@gmail.com.
# SEED_ADMIN_EMAIL=
